<resources>
    <!-- Base application theme. -->
    <style name="MaterialTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorCoccoc</item>
        <item name="colorPrimaryDark">@color/colorAppBackground</item>
        <item name="colorAccent">@color/colorCoccoc</item>
        <item name="android:windowBackground">@color/colorAppBackground</item>
    </style>

    <style name="ChromiumTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorCoccoc</item>
        <item name="colorPrimaryDark">@color/colorAppBackground</item>
        <item name="colorAccent">@color/colorCoccoc</item>
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialogTheme</item>
    </style>

    <style name="circleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="behavior_fitToContents">true</item>
        <item name="behavior_peekHeight">1000dp</item>
    </style>

    <!-- set the rounded drawable as background to your bottom sheet -->
    <style name="BottomSheet" parent="@style/Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_dialog</item>
    </style>

    <style name="BaseBottomSheetDialog" parent="@style/Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/BottomSheet</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="BaseBottomSheetDialog">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="NewsTabLayout">
        <item name="tabMode">scrollable</item>
        <item name="tabSelectedTextColor">@color/news_tab_selected_textcolor</item>
        <item name="tabTextColor">@color/news_tab_textcolor</item>
        <item name="tabTextAppearance">@style/NewsTabTextStyle</item>
        <item name="tabMinWidth">32dp</item>
        <item name="tabIndicatorHeight">0dp</item>
        <item name="tabGravity">start</item>
        <item name="tabPaddingEnd">8dp</item>
        <item name="tabPaddingStart">0dp</item>
        <item name="tabRippleColor">@android:color/transparent</item>
    </style>

    <style name="NewsTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>